# ---- Postgres (backend + docker compose) ----
POSTGRES_USER=proofchain
POSTGRES_PASSWORD=proofchain
POSTGRES_DB=proofchain
DATABASE_URL=postgres://proofchain:proofchain@localhost:5433/proofchain

# ---- Redis / BullMQ ----
REDIS_URL=redis://localhost:6380

# ---- Backend ----
PORT=3000
JWT_SECRET=change-me-in-production
# Comma-separated device public keys are stored per-collector in the DB, not here.

# ---- Weigh-in photos ----
# Filesystem path; needs a mounted volume and a backup policy in any real
# deployment. Contains personal data about identifiable collectors.
PHOTO_STORAGE_DIR=./var/photos
MAX_PHOTO_BYTES=8388608
# Or an S3-compatible bucket, which replaces PHOTO_STORAGE_DIR when set — for
# hosts whose disk does not survive a restart. R2: endpoint
# https://<account-id>.r2.cloudflarestorage.com, region auto. Supabase:
# https://<project-ref>.storage.supabase.co/storage/v1/s3 plus the project's
# region. AWS: leave the endpoint unset.
# PHOTO_S3_BUCKET=
# PHOTO_S3_ENDPOINT=
# PHOTO_S3_REGION=auto
# PHOTO_S3_ACCESS_KEY_ID=
# PHOTO_S3_SECRET_ACCESS_KEY=
# PHOTO_S3_FORCE_PATH_STYLE=   (defaults to true when an endpoint is set)
